# ClipFetch environment configuration

# Frontend allowed origins (comma-separated)
CLIPFETCH_FRONTEND_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# Outbound security proxy
# Local development: leave empty unless Squid is running locally.
CLIPFETCH_EGRESS_PROXY=

# Local development: false
# Production: true when the security proxy is configured and reachable.
CLIPFETCH_REQUIRE_EGRESS_PROXY=false
