# ClipFetch process environment configuration
# The application reads these from the process environment; it does not load .env automatically.

# Comma-separated exact origins allowed to call the API.
CLIPFETCH_FRONTEND_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# Temporary files are created in private per-request directories under this parent.
CLIPFETCH_TEMP_DIR=/tmp/clipfetch-downloads

# Optional local HTTP egress proxy, for example http://127.0.0.1:3128.
# The application accepts only a loopback proxy address.
CLIPFETCH_EGRESS_PROXY=

# Set true only when the loopback proxy is running and enforces safe outbound access.
# Requests fail closed when true and the proxy setting is missing or invalid.
CLIPFETCH_REQUIRE_EGRESS_PROXY=false
