# ClipFetch process environment configuration
# The application reads these from the process environment; it does not load .env automatically.

# Comma-separated exact origins allowed to call the API.
CLIPFETCH_FRONTEND_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# Temporary files are created in private per-request directories under this parent.
CLIPFETCH_TEMP_DIR=/tmp/clipfetch-downloads

# Required filtering proxy. In single-container production, the supervisor runs
# filtering_proxy on loopback 127.0.0.1:3128 inside the same container.
CLIPFETCH_EGRESS_PROXY=http://127.0.0.1:3128

# Requests fail closed when the proxy setting is missing or invalid.
# Set false only for isolated local development without the supervisor/proxy.
CLIPFETCH_REQUIRE_EGRESS_PROXY=true

# Loopback bind address and port for filtering_proxy:
CLIPFETCH_PROXY_BIND=127.0.0.1
CLIPFETCH_PROXY_PORT=3128
